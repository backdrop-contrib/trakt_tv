<?php

  function trakt_tv_install() {

    $item = array(
      'link_title' => st('Trending TV Shows'),
      'link_path' => 'trakt-tv',
      'menu_name' => 'main-menu',
      'weight' => -1,
      'customized' => 1,
    );
    menu_link_save($item);

    // Create a login link in the account menu.
    $item = array(
      'link_title' => st('Trakt TV Search'),
      'link_path' => 'trakt-tv-search',
      'menu_name' => 'main-menu',
      'weight' => -1,
      'customized' => 1,
    );
    menu_link_save($item);

    // Update the menu router information.
    menu_rebuild();

    // Fresh installs get these from config/ along with the other fields.
    // These calls are no-ops then; they only matter if that config was
    // skipped for some reason.
    _trakt_tv_ensure_poster_field();
    _trakt_tv_ensure_refresh_fields();
  }

/**
 * Add a Poster image field to TV Show content.
 */
function trakt_tv_update_1100() {
  _trakt_tv_ensure_poster_field();
}

/**
 * Add Next episode and Streaming on fields, kept up to date from Trakt.
 */
function trakt_tv_update_1101() {
  // Next episode is a date field.
  if (!module_exists('date')) {
    module_enable(['date']);
  }
  _trakt_tv_ensure_refresh_fields();
}

/**
 * Ensure the field_poster field and its tv_show instance exist. Idempotent.
 */
function _trakt_tv_ensure_poster_field() {
  _trakt_tv_ensure_field('field_poster');
}

/**
 * Ensure the fields filled by the show refresh exist. Idempotent.
 *
 * @see trakt_tv_refresh_node()
 */
function _trakt_tv_ensure_refresh_fields() {
  if (!taxonomy_vocabulary_load('streaming_services')) {
    $data = _trakt_tv_read_config('taxonomy.vocabulary.streaming_services');
    taxonomy_vocabulary_save(new TaxonomyVocabulary($data));
  }
  _trakt_tv_ensure_field('field_next_episode');
  _trakt_tv_ensure_field('field_streaming');
}

/**
 * Ensure a field and its tv_show instance exist. Idempotent.
 *
 * Reads the definitions from the module's config/ directory, so fresh
 * installs and updated sites get exactly the same field.
 *
 * @param string $field_name
 *   The field's machine name.
 */
function _trakt_tv_ensure_field($field_name) {
  if (!field_info_field($field_name)) {
    field_create_field(_trakt_tv_read_config('field.field.' . $field_name));
  }
  if (!field_info_instance('node', $field_name, 'tv_show') && node_type_load('tv_show')) {
    field_create_instance(_trakt_tv_read_config('field.instance.node.tv_show.' . $field_name));
  }
}

/**
 * Reads one of the module's default config files.
 *
 * @param string $config_name
 *   Config name without the .json extension.
 *
 * @return array
 *   The config data, without its _config_name key.
 */
function _trakt_tv_read_config($config_name) {
  $file = backdrop_get_path('module', 'trakt_tv') . '/config/' . $config_name . '.json';
  $data = json_decode(file_get_contents($file), TRUE);
  unset($data['_config_name']);
  return $data;
}
