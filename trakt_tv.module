<?php



function trakt_tv_init() {
  module_load_include('inc', 'trakt_tv', 'trakt_tv.api');
  module_load_include('inc', 'trakt_tv', 'trakt_tv.nodes');

  // After approving access, Trakt sends the person to the Redirect URI (often
  // the home page) with ?code=... (sometimes also &iss=https://trakt.tv). If
  // an authorization is waiting, take them back to the exchange form with the
  // code filled in.
  $exchange_path = 'admin/config/media/trakt_tv/auth-exchange';
  if (!empty($_GET['code']) && is_string($_GET['code'])
    && (!isset($_GET['iss']) || $_GET['iss'] === 'https://trakt.tv')
    && current_path() !== $exchange_path
    && user_access('administer site configuration')
    && state_get('trakt_tv_pkce_verifier')) {
    backdrop_goto($exchange_path, ['query' => ['code' => $_GET['code']]]);
  }
}

/**
 * Implements hook_cron().
 *
 * Renews the Trakt access token before it expires. Each refresh also issues a
 * new refresh token, so a site with regular cron runs never needs to be
 * re-authorized by hand, even when nobody visits it.
 */
function trakt_tv_cron() {
  module_load_include('inc', 'trakt_tv', 'trakt_tv.api');
  $tokens = trakt_tv_token_store_get();
  if (!empty($tokens['refresh_token'])) {
    trakt_tv_get_valid_token(2 * 86400);
  }
}

/**
 * Implements hook_permission().
 * Defines permissions for the Trakt TV module.
 */
function trakt_tv_permission() {
  return [
    'save tv shows' => [
      'title' => t('Save TV shows to the database'),
      'description' => t('Allow users to save TV shows from the Trakt API to the database.'),
    ],
  ];
}

/**
 * Implements hook_menu().
 */
function trakt_tv_menu() {


  $items = [];

  // Route for trending TV shows.
  $items['trakt-tv'] = [
    'title' => 'Trending TV Shows on Trakt',
    'page callback' => 'trakt_tv_display',
    'access arguments' => ['access content'],
    'type' => MENU_CALLBACK,
  ];

  // Route for the search form.
  $items['trakt-tv-search'] = [
    'title' => 'Search Trakt TV',
    'page callback' => 'drupal_get_form',
    'page arguments' => ['trakt_tv_search_form'],
    'access arguments' => ['access content'],
    'type' => MENU_CALLBACK,
  ];

  // Route for search results.
  $items['trakt-tv-search-results/%'] = [
    'title' => 'Trakt TV Search Results',
    'page callback' => 'trakt_tv_search_results_page',
    'page arguments' => [1],
    'access arguments' => ['access content'],
    'type' => MENU_CALLBACK,
  ];

  // Route for creating a node from search results.
  $items['trakt-tv-create-node-from-id/%'] = [
    'title' => 'Create TV Show Node',
    'page callback' => 'trakt_tv_create_node_from_trakt_id',
    'page arguments' => [1],
    'access arguments' => ['save tv shows'],
    'type' => MENU_CALLBACK,
  ];

  $items['admin/config/media/trakt_tv'] = [
    'title' => 'Trakt TV Settings',
    'description' => 'Configure API settings for Trakt TV integration.',
    'page callback' => 'drupal_get_form',
    'page arguments' => ['trakt_tv_settings_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_NORMAL_ITEM,
  ];

  $items['admin/config/media/trakt_tv/auth-exchange'] = [
    'title' => 'Trakt Auth Code Exchange',
    'description' => 'Enter an auth code from Trakt to get your access token.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['trakt_tv_auth_code_exchange_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_NORMAL_ITEM,
    'file' => 'trakt_tv.forms.inc',
  ];

  $items['admin/config/media/trakt_tv/authorize'] = [
    'title' => 'Authorize with Trakt',
    'page callback' => 'trakt_tv_authorize_redirect',
    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
    'file' => 'trakt_tv.forms.inc',
  ];


  return $items;
}

/**
 * Form to manage Trakt TV API settings.
 */
function trakt_tv_settings_form($form, &$form_state) {
  $creds = trakt_tv_get_credentials();

  // Ensure the key exists or set a default.
  $client_id = isset($creds['client_id']) ? $creds['client_id'] : '';
  $client_secret = isset($creds['client_secret']) ? $creds['client_secret'] : '';
  $redirect_uri = isset($creds['redirect_uri']) ? $creds['redirect_uri'] : '';

  $form['intro'] = [
    '#type' => 'markup',
    '#markup' => t('You will need to create an account at <a href="@url" target="_blank">@url</a> to get the credentials necessary to use the API required by this module.', [
      '@url' => 'https://trakt.tv/oauth/applications/new',
    ]),
  ];

  $form['client_id'] = [
    '#type' => 'textfield',
    '#title' => t('Client ID'),
    '#default_value' => $client_id,
    '#required' => FALSE,
  ];

  $form['redirect_uri'] = [
    '#type' => 'textfield',
    '#title' => t('Redirect URI'),
    '#description' => t('Must exactly match a Redirect URI on your Trakt app. Using this site\'s exchange page is easiest: @url', [
      '@url' => url('admin/config/media/trakt_tv/auth-exchange', ['absolute' => TRUE]),
    ]),
    '#default_value' => $redirect_uri,
    '#required' => FALSE,
  ];

  // New Trakt apps use PKCE and have no client secret. Keep the field for
  // older apps, collapsed unless a secret is already saved.
  $form['legacy'] = [
    '#type' => 'fieldset',
    '#title' => t('Legacy Trakt apps'),
    '#collapsible' => TRUE,
    '#collapsed' => empty($client_secret),
  ];

  $form['legacy']['client_secret'] = [
    '#type' => 'textfield',
    '#title' => t('Client Secret'),
    '#description' => t('Only for Trakt apps created before PKCE sign-in. New apps do not issue a client secret; leave this empty.'),
    '#default_value' => $client_secret,
    '#required' => FALSE,
  ];

  $form['submit'] = [
    '#type' => 'submit',
    '#value' => t('Save Configuration'),
  ];

  if (field_info_instance('node', 'field_poster', 'tv_show')) {
    $missing = count(trakt_tv_nids_missing_poster());
    $form['posters'] = [
      '#type' => 'fieldset',
      '#title' => t('Posters'),
      '#description' => t('New shows get their poster when they are added. Shows added earlier can fetch theirs here. Shows that already have a poster are skipped.'),
    ];
    $form['posters']['status'] = [
      '#markup' => '<p>' . format_plural($missing, '1 show has no poster yet.', '@count shows have no poster yet.') . '</p>',
    ];
    $form['posters']['fetch_posters'] = [
      '#type' => 'submit',
      '#value' => t('Fetch missing posters'),
      '#submit' => ['trakt_tv_fetch_posters_submit'],
      '#limit_validation_errors' => [],
      '#disabled' => !$missing,
    ];
  }

  return $form;
}

/**
 * Submit handler for the "Fetch missing posters" button.
 */
function trakt_tv_fetch_posters_submit($form, &$form_state) {
  batch_set(trakt_tv_poster_backfill_batch());
}

/**
 * Submit handler for Trakt TV API settings form.
 */
function trakt_tv_settings_form_submit($form, &$form_state) {

  $values = $form_state['values'];

  $credentials = [
    'client_id' => $form_state['values']['client_id'],
    'client_secret' => $form_state['values']['client_secret'],
    'redirect_uri' => $form_state['values']['redirect_uri'],
  ];

  file_unmanaged_save_data(json_encode($credentials), 'private://credentials.json', FILE_EXISTS_REPLACE);
  backdrop_set_message(t('Trakt credentials saved to private directory.'));
  backdrop_set_message(t('Next, authorize this site with Trakt on the <a href="@url">Trakt Auth Code Exchange</a> page.', [
    '@url' => url('admin/config/media/trakt_tv/auth-exchange'),
  ]), 'info');
}


/**
 * Display trending TV shows.
 */
function trakt_tv_display() {
  $shows = trakt_tv_fetch_trending();
  $table = '';

  if (empty($shows)) {
    return '<p>Unable to fetch TV shows at the moment. Please try again later.</p>';
  }
  return trakt_tv_create_table($shows);
}


/**
 * Create table of shows.
 */

function trakt_tv_create_table($shows) {
  $header = ['Title', 'Year', 'Status'];
  $rows = [];

  foreach ($shows as $show) {
    $rows[] = [
      $show['show']['title'],
      $show['show']['year'],
      trakt_tv_node_check($show),
    ];
  }

  // Return both a message and the table in a render array.
  return [
    'intro' => [
      '#markup' => '<p><strong>Here are the top 20 trending shows on Trakt TV.</strong></p>',
    ],
    'table' => [
      '#theme' => 'table',
      '#header' => $header,
      '#rows' => $rows,
    ],
  ];
}


/**
 * Search form for finding and creating TV show nodes.
 */
function trakt_tv_search_form($form, &$form_state) {
  $form['search_query'] = [
    '#type' => 'textfield',
    '#title' => t('Search for a Show on Trakt TV'),
    '#description' => t('Enter the name of the TV show to search.'),
    '#required' => TRUE,
  ];

  $form['actions'] = [
    '#type' => 'actions',
    'submit' => [
      '#type' => 'submit',
      '#value' => t('Search'),
      '#submit' => ['trakt_tv_search_form_submit'],
    ],
  ];

  return $form;
}


/**
 * Submit handler for the TV show search form.
 */
function trakt_tv_search_form_submit($form, &$form_state) {
  $query = trim($form_state['values']['search_query']); // Remove extra spaces.

  if (empty($query)) {
    drupal_set_message(t('Please enter a valid TV show name.'), 'error');
    watchdog('trakt_tv', 'Search form submitted with an empty query.', [], WATCHDOG_WARNING);
    return;
  }

  // Log the sanitized query.
  watchdog('trakt_tv', 'Search form submitted with query: @query', ['@query' => $query], WATCHDOG_DEBUG);

  // Redirect to the search results page with the query.
  $form_state['redirect'] = 'trakt-tv-search-results/' . check_plain($query);
}


/**
 * Display search results and allow node creation.
 */
function trakt_tv_search_results_page($query) {
  $shows = trakt_tv_search_api($query);

  if (empty($shows)) {
    return '<p>No TV shows found for the query: ' . check_plain($query) . '</p>';
  }
  return trakt_tv_create_table($shows);
}

/**
 * Implements hook_block_info().
 */
function trakt_tv_block_info() {
  $blocks['recently_watched'] = [
    'info' => t('Trakt TV: Recently watched episodes'),
    'description' => t("Displays the most recently watched episodes from the site owner's connected Trakt TV account."),
  ];
  $blocks['upcoming_episodes'] = [
    'info' => t('Trakt TV: Upcoming episodes'),
    'description' => t("Displays upcoming episodes for shows on the site owner's Trakt TV watchlist."),
  ];
  return $blocks;
}

/**
 * Implements hook_block_configure().
 */
function trakt_tv_block_configure($delta = '', $settings = []) {
  $form = [];
  if ($delta === 'recently_watched') {
    $settings += ['item_count' => 5];
    $form['item_count'] = [
      '#type' => 'select',
      '#title' => t('Number of episodes to show'),
      '#options' => backdrop_map_assoc([3, 5, 10, 15, 20]),
      '#default_value' => $settings['item_count'],
    ];
  }
  elseif ($delta === 'upcoming_episodes') {
    $settings += ['days_ahead' => 7];
    $form['days_ahead'] = [
      '#type' => 'select',
      '#title' => t('Days ahead'),
      '#options' => [
        3 => t('3 days'),
        7 => t('1 week'),
        14 => t('2 weeks'),
        30 => t('1 month'),
      ],
      '#default_value' => $settings['days_ahead'],
    ];
  }
  return $form;
}

/**
 * Implements hook_block_view().
 */
function trakt_tv_block_view($delta = '', $settings = [], $contexts = []) {
  module_load_include('inc', 'trakt_tv', 'trakt_tv.api');

  switch ($delta) {
    case 'recently_watched':
      return _trakt_tv_block_recently_watched($settings);
    case 'upcoming_episodes':
      return _trakt_tv_block_upcoming_episodes($settings);
  }
}

/**
 * Render the "Recently watched on Trakt" block.
 */
function _trakt_tv_block_recently_watched($settings) {
  $count = isset($settings['item_count']) ? (int) $settings['item_count'] : 5;
  $count = max(1, min(50, $count));

  $cid = 'trakt_tv:history:' . $count;
  $history = NULL;
  if ($cached = cache_get($cid)) {
    $history = $cached->data;
  }
  if ($history === NULL) {
    $history = trakt_tv_fetch_history($count);
    if (!empty($history)) {
      cache_set($cid, $history, 'cache', REQUEST_TIME + (15 * 60));
    }
  }

  $block = [
    'subject' => t('Recently watched on Trakt'),
    'content' => [],
  ];

  if (empty($history)) {
    $block['content']['#markup'] = '<p>' . t('No recent activity to display.') . '</p>';
    return $block;
  }

  $items = [];
  foreach ($history as $item) {
    if (empty($item['show']['title']) || empty($item['episode'])) {
      continue;
    }
    $ep = $item['episode'];
    $show_title = check_plain($item['show']['title']);
    $ep_code = sprintf('S%02dE%02d', (int) $ep['season'], (int) $ep['number']);
    $ep_title = !empty($ep['title']) ? check_plain($ep['title']) : '';

    $watched_at = !empty($item['watched_at']) ? strtotime($item['watched_at']) : 0;
    $ago = ($watched_at && $watched_at <= REQUEST_TIME)
      ? t('@interval ago', ['@interval' => format_interval(REQUEST_TIME - $watched_at, 2)])
      : '';

    $line = '<strong>' . $show_title . '</strong> · ' . $ep_code;
    if ($ep_title !== '') {
      $line .= ' · ' . $ep_title;
    }
    if ($ago !== '') {
      $line .= ' <span class="trakt-tv-ago">(' . $ago . ')</span>';
    }
    $items[] = $line;
  }

  $block['content']['list'] = [
    '#theme' => 'item_list',
    '#items' => $items,
    '#attributes' => ['class' => ['trakt-tv-recently-watched']],
  ];

  return $block;
}

/**
 * Render the "Upcoming episodes on Trakt" block.
 */
function _trakt_tv_block_upcoming_episodes($settings) {
  $days = isset($settings['days_ahead']) ? (int) $settings['days_ahead'] : 7;
  $days = max(1, min(60, $days));

  $cid = 'trakt_tv:upcoming:' . $days;
  $upcoming = NULL;
  if ($cached = cache_get($cid)) {
    $upcoming = $cached->data;
  }
  if ($upcoming === NULL) {
    $upcoming = trakt_tv_fetch_upcoming($days);
    if (!empty($upcoming)) {
      cache_set($cid, $upcoming, 'cache', REQUEST_TIME + (15 * 60));
    }
  }

  $block = [
    'subject' => t('Upcoming on Trakt'),
    'content' => [],
  ];

  if (empty($upcoming)) {
    $block['content']['#markup'] = '<p>' . t('No upcoming episodes to display.') . '</p>';
    return $block;
  }

  $items = [];
  foreach ($upcoming as $item) {
    if (empty($item['show']['title']) || empty($item['episode'])) {
      continue;
    }
    $ep = $item['episode'];
    $show_title = check_plain($item['show']['title']);
    $ep_code = sprintf('S%02dE%02d', (int) $ep['season'], (int) $ep['number']);
    $ep_title = !empty($ep['title']) ? check_plain($ep['title']) : '';

    $airs_at = !empty($item['first_aired']) ? strtotime($item['first_aired']) : 0;
    $when = '';
    if ($airs_at) {
      if ($airs_at > REQUEST_TIME) {
        $when = t('in @interval', ['@interval' => format_interval($airs_at - REQUEST_TIME, 2)]);
      }
      else {
        $when = t('@interval ago', ['@interval' => format_interval(REQUEST_TIME - $airs_at, 2)]);
      }
    }

    $line = '<strong>' . $show_title . '</strong> · ' . $ep_code;
    if ($ep_title !== '') {
      $line .= ' · ' . $ep_title;
    }
    if ($when !== '') {
      $line .= ' <span class="trakt-tv-when">(' . $when . ')</span>';
    }
    $items[] = $line;
  }

  $block['content']['list'] = [
    '#theme' => 'item_list',
    '#items' => $items,
    '#attributes' => ['class' => ['trakt-tv-upcoming-episodes']],
  ];

  return $block;
}

/**
 * Implements hook_field_formatter_info().
 */
function trakt_tv_field_formatter_info() {
  return [
    'trakt_tv_link' => [
      'label' => t('Link to Trakt'),
      'description' => t("A link to the show's page on Trakt, built from its Trakt ID."),
      'field types' => ['text', 'number_integer'],
      'settings' => [
        'link_text' => 'View on Trakt',
        'new_window' => TRUE,
      ],
    ],
  ];
}

/**
 * Implements hook_field_formatter_settings_form().
 */
function trakt_tv_field_formatter_settings_form($field, $instance, $view_mode, $form, &$form_state) {
  $settings = $instance['display'][$view_mode]['settings'];
  return [
    'link_text' => [
      '#type' => 'textfield',
      '#title' => t('Link text'),
      '#default_value' => $settings['link_text'],
      '#required' => TRUE,
    ],
    'new_window' => [
      '#type' => 'checkbox',
      '#title' => t('Open in a new window'),
      '#default_value' => $settings['new_window'],
    ],
  ];
}

/**
 * Implements hook_field_formatter_settings_summary().
 */
function trakt_tv_field_formatter_settings_summary($field, $instance, $view_mode) {
  $settings = $instance['display'][$view_mode]['settings'];
  return t('Link text: @text', ['@text' => $settings['link_text']]);
}

/**
 * Implements hook_field_formatter_view().
 */
function trakt_tv_field_formatter_view($entity_type, $entity, $field, $instance, $langcode, $items, $display) {
  $element = [];
  $settings = $display['settings'];
  foreach ($items as $delta => $item) {
    // Trakt IDs are numeric. trakt.tv/shows/ID redirects to the show's page.
    $trakt_id = trim((string) ($item['value'] ?? ''));
    if (!ctype_digit($trakt_id)) {
      continue;
    }
    $options = $settings['new_window'] ? ['attributes' => ['target' => '_blank', 'rel' => 'noopener']] : [];
    $element[$delta] = [
      '#type' => 'link',
      '#title' => $settings['link_text'],
      '#href' => 'https://trakt.tv/shows/' . $trakt_id,
      '#options' => $options,
    ];
  }
  return $element;
}
